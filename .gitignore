data/bronze/
data/silver/
data/gold/
data/*.duckdb
data/*.duckdb.wal

# Lo que generan Python, dbt y el editor
__pycache__/
.pytest_cache/
.venv/
dbt/target/
dbt/logs/
dbt/.user.yml
logs/
.vscode/

